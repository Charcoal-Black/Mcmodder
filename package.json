{
  "name": "mcmodder",
  "private": true,
  "version": "2.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:manual": "E2E_ASSETS=1 E2E_MANUAL=1 playwright test --project=manual",
    "e2e:assets": "node scripts/e2e-assets.mjs",
    "e2e:assets:record": "E2E_ASSETS_RECORD=1 E2E_MANUAL=1 playwright test --project=manual",
    "typecheck:e2e": "vue-tsc -p e2e --noEmit",
    "lint": "eslint src",
    "smoke:attitude": "node smoke/attitude-plaza.mjs",
    "lint:config": "eslint eslint.config.ts eslint-local-rules vite.config.ts prettier.config.ts lint-staged.config.ts",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e eslint.config.ts eslint-local-rules vite.config.ts prettier.config.ts lint-staged.config.ts",
    "verify": "npm run lint && npm run lint:config && npm run typecheck:e2e && npm run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^0.20.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/codemirror": "^5.60.17",
    "@types/jquery": "^2.0.68",
    "@types/jquery.cookie": "^1.4.36",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.184.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "codemirror": "^5.65.20",
    "dpdm": "^4.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jquery": "2.1.0",
    "js-beautify": "^1.15.4",
    "lint-staged": "^17.6.0",
    "pinyin": "^4.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.9",
    "supabase": "^2.121.0",
    "systemjs": "^6.15.1",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.3",
    "vite-plugin-monkey": "^7.1.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "dexie": "^4.4.4",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "emoji-picker-element": "^1.29.1",
    "opentype.js": "^2.0.0",
    "pinyin-match": "^1.2.10",
    "three": "^0.184.0",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.4.0",
    "vue-component-type-helpers": "^3.3.12",
    "vue-virtual-scroller": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents": false
  }
}
